# GitHub Configuration for Image Uploads
# Get a personal access token from: https://github.com/settings/tokens
# Required scopes: repo (or repo:public_repo for public repos only)

GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org_name
GITHUB_REPO=your_repository_name_for_images
GITHUB_IMAGE_PATH=course-images
